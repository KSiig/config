#!/bin/sh
# clip - send stdin to the local (Mac) system clipboard via OSC 52.
#
# Why this exists: on the mosh + tmux path, tmux's own OSC 52 emitter
# (`load-buffer -w` / `set-buffer -w`, copy-mode yank with set-clipboard on)
# does NOT reach the Mac clipboard. Application-emitted OSC 52 written to a
# real tty does. So we write the sequence ourselves.
#
# Target tty, in order of preference:
#   1. the attached tmux client's tty  - bypasses tmux entirely, so it works
#      even when the calling pane is in a window you are not looking at
#   2. our own stdout, if it is a tty  - the no-tmux case
#
# Usage:
#   echo hi | clip
#   clip < file
#   clip "some text"

set -e

if [ "$#" -gt 0 ]; then
    payload=$(printf '%s' "$*" | base64 | tr -d '\n')
else
    payload=$(base64 | tr -d '\n')
fi

client_tty() {
    command -v tmux >/dev/null 2>&1 || return 0
    for t in $(tmux list-clients -F '#{client_tty}' 2>/dev/null); do
        if [ -w "$t" ]; then
            printf '%s' "$t"
            return 0
        fi
    done
}

target=''

# Inside tmux: always prefer the client tty. Our own stdout is usually a pipe
# here (copy-pipe, run-shell), and even when it is a tty it belongs to a pane
# that may not be the visible one - OSC 52 from a hidden window gets dropped.
[ -n "$TMUX" ] && target=$(client_tty)

# Outside tmux (e.g. a bare mosh shell): our stdout is the real terminal.
[ -z "$target" ] && [ -t 1 ] && target='/dev/stdout'

# Last resort: invoked with no TMUX and no tty (copy-pipe can look like this).
[ -z "$target" ] && target=$(client_tty)

if [ -z "$target" ]; then
    echo "clip: no tty to write OSC 52 to (no attached tmux client, stdout not a tty)" >&2
    exit 1
fi

printf '\033]52;c;%s\007' "$payload" > "$target"
