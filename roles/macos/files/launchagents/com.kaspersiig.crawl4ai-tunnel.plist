<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kaspersiig.crawl4ai-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>ssh</string>
    <string>-N</string>
    <string>-o</string>
    <string>ServerAliveInterval=20</string>
    <string>-o</string>
    <string>ServerAliveCountMax=3</string>
    <string>-o</string>
    <string>ExitOnForwardFailure=yes</string>
    <string>-o</string>
    <string>StrictHostKeyChecking=accept-new</string>
    <string>-R</string>
    <string>28939:127.0.0.1:9223</string>
    <string>-R</string>
    <string>28940:127.0.0.1:9333</string>
    <string>workbox</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/crawl4ai-tunnel.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/crawl4ai-tunnel.err</string>
</dict>
</plist>
