#!/usr/bin/env python3
"""crawl4aid — laptop-side HTTP daemon for pi-crawl4ai.

Owns the Edge browser lifecycle on the laptop:
- Starts Edge with --remote-debugging-port=9222 against an isolated profile
- Swaps modes (headless/headed) on demand, idempotently
- Exposes a tiny HTTP API on 127.0.0.1:9333

The workbox-side pi-crawl4ai extension talks to this daemon over an SSH
reverse tunnel (127.0.0.1:18340 on the workbox → 127.0.0.1:9333 here).
The CDP URL exposed to crwl is ws://127.0.0.1:18339 (workbox-side, also
tunneled to laptop:9222).

Stdlib only — no pip dependencies.

Endpoints:
  POST /mode   {mode: "headed"|"headless"} → ensure Edge is in given mode
  POST /ensure {mode?: "headed"|"headless"} → start Edge if not running
  GET  /status                                  → current daemon state
  GET  /health                                  → alive check ({"ok": true})

State files (under ~/.crawl4ai/):
  daemon.state    — {mode, edge_pid}
  daemon.pid      — current daemon PID
  edge.state      — written by crawl4ai-edge-up: {pid, mode, debug_port}
  edge.pid        — written by crawl4ai-edge-up: just the PID
  daemon.log      — append-only daemon log
"""

from __future__ import annotations

import http.server
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

DAEMON_HOST = "127.0.0.1"
DAEMON_PORT = 9333
EDGE_CDP_PORT = int(os.environ.get("CRAWL4AI_DEBUG_PORT", "9223"))

STATE_DIR = Path.home() / ".crawl4ai"
LOG_PATH = STATE_DIR / "daemon.log"
STATE_PATH = STATE_DIR / "daemon.state"
PID_PATH = STATE_DIR / "daemon.pid"

LAUNCHER = Path.home() / "bin" / "crawl4ai-edge-up"
EDGE_LAUNCHER_STATE = STATE_DIR / "edge.state"

VALID_MODES = {"headed", "headless"}


def log(msg: str) -> None:
    """Append-only log to ~/.crawl4ai/daemon.log."""
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        ts = time.strftime("%Y-%m-%d %H:%M:%S")
        with LOG_PATH.open("a") as f:
            f.write(f"[{ts}] {msg}\n")
    except Exception:
        # Logging must never raise
        pass


def is_process_alive(pid: int | None) -> bool:
    if pid is None:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def read_state() -> dict:
    if not STATE_PATH.exists():
        return {"mode": None, "edge_pid": None}
    try:
        s = json.loads(STATE_PATH.read_text())
        return {"mode": s.get("mode"), "edge_pid": s.get("edge_pid")}
    except Exception:
        return {"mode": None, "edge_pid": None}


def write_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(state))


def read_launcher_state() -> dict | None:
    if not EDGE_LAUNCHER_STATE.exists():
        return None
    try:
        return json.loads(EDGE_LAUNCHER_STATE.read_text())
    except Exception:
        return None


def launch_edge(mode: str) -> None:
    """Invoke the launcher script. Raises on failure."""
    if not LAUNCHER.exists():
        raise RuntimeError(f"launcher not found at {LAUNCHER}")
    log(f"invoking launcher: {LAUNCHER} {mode}")
    result = subprocess.run(
        [str(LAUNCHER), mode],
        capture_output=True,
        text=True,
        timeout=30,
    )
    if result.returncode != 0:
        raise RuntimeError(f"launcher exited {result.returncode}: {result.stderr.strip()}")
    log(f"launcher stdout: {result.stdout.strip()}")


def set_mode(mode: str) -> tuple[int, dict]:
    """POST /mode handler. Returns (status_code, json_body)."""
    if mode not in VALID_MODES:
        return 400, {"error": f"invalid mode; must be one of {sorted(VALID_MODES)}"}

    state = read_state()

    # Already in this mode and Edge is alive? Idempotent no-op.
    if state["mode"] == mode and is_process_alive(state["edge_pid"]):
        log(f"mode={mode} already active, edge_pid={state['edge_pid']}; no-op")
        launcher_state = read_launcher_state()
        return 200, {
            "mode": mode,
            "edge_pid": state["edge_pid"],
            "cdp_url": launcher_state.get("cdp_url") if launcher_state else None,
            "noop": True,
        }

    # Different mode (or stale state) — kill current Edge if alive.
    if is_process_alive(state["edge_pid"]):
        log(f"killing edge_pid={state['edge_pid']} to switch modes")
        try:
            os.kill(state["edge_pid"], signal.SIGTERM)
            time.sleep(0.7)
        except OSError as e:
            log(f"SIGTERM to {state['edge_pid']} failed: {e}")

    # Launch in the new mode.
    try:
        launch_edge(mode)
    except Exception as e:
        log(f"launch failed: {e}")
        return 500, {"error": str(e)}

    # The launcher wrote its own state file; pull PID + cdp_url from there.
    # The cdp_url includes the dynamic browser id that crwl needs to connect.
    launcher_state = read_launcher_state()
    edge_pid = launcher_state.get("pid") if launcher_state else None
    cdp_url = launcher_state.get("cdp_url") if launcher_state else None

    if not cdp_url:
        # The launcher succeeded but didn't capture the URL — fatal for the
        # workbox-side path. Surface a clear error so the extension can fall
        # back to bundled Chromium.
        log("launcher reported success but no cdp_url captured; falling back expected")
        return 500, {"error": "launcher succeeded but cdp_url missing from edge.state"}

    write_state({"mode": mode, "edge_pid": edge_pid})
    log(f"mode set to {mode}, edge_pid={edge_pid}, cdp_url={cdp_url}")
    return 200, {"mode": mode, "edge_pid": edge_pid, "cdp_url": cdp_url}


def get_status() -> tuple[int, dict]:
    state = read_state()
    launcher_state = read_launcher_state()
    cdp_url = launcher_state.get("cdp_url") if launcher_state else None
    return 200, {
        "mode": state["mode"],
        "edge_pid": state["edge_pid"] if is_process_alive(state["edge_pid"]) else None,
        "cdp_url": cdp_url,
        "daemon_pid": os.getpid(),
    }


class Handler(http.server.BaseHTTPRequestHandler):
    """HTTP request handler. All responses are JSON."""

    def log_message(self, fmt: str, *args) -> None:
        # Replace BaseHTTPRequestHandler's stderr logging with our append-only log.
        log(f"{self.address_string()} - {fmt % args}")

    def _send_json(self, status: int, body: dict) -> None:
        try:
            payload = json.dumps(body).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
        except BrokenPipeError:
            pass

    def _read_body(self) -> dict | None:
        length = int(self.headers.get("Content-Length", 0) or 0)
        if length == 0:
            return None
        try:
            return json.loads(self.rfile.read(length).decode())
        except Exception:
            return None

    def do_GET(self) -> None:
        if self.path == "/health":
            self._send_json(200, {"ok": True})
        elif self.path == "/status":
            status, body = get_status()
            self._send_json(status, body)
        else:
            self._send_json(404, {"error": "not found"})

    def do_POST(self) -> None:
        body = self._read_body() or {}
        if self.path == "/mode":
            mode = body.get("mode")
            if not isinstance(mode, str):
                self._send_json(400, {"error": "missing or invalid 'mode' field"})
                return
            status, resp = set_mode(mode)
            self._send_json(status, resp)
        elif self.path == "/ensure":
            mode = body.get("mode", "headless")
            if not isinstance(mode, str):
                self._send_json(400, {"error": "missing or invalid 'mode' field"})
                return
            status, resp = set_mode(mode)
            self._send_json(status, resp)
        else:
            self._send_json(404, {"error": "not found"})


def main() -> int:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    PID_PATH.write_text(str(os.getpid()))

    log(f"daemon starting on {DAEMON_HOST}:{DAEMON_PORT} (pid={os.getpid()})")
    server = http.server.HTTPServer((DAEMON_HOST, DAEMON_PORT), Handler)
    log("daemon ready")

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        log("daemon stopping (keyboard interrupt)")
    finally:
        try:
            PID_PATH.unlink()
        except FileNotFoundError:
            pass
        server.server_close()

    return 0


if __name__ == "__main__":
    sys.exit(main())
