export PLANNOTATOR_PORT=29432-29481

plannotators() {
  local pids=( ${(f)"$(pgrep plannotator)"} )
  if (( ${#pids} )); then
    ps -p "${pids[@]}" -o pid=,lstart=,args=
    print -r -- '--- listening ports ---'
    lsof -a -p "${(j:,:)pids}" -iTCP -sTCP:LISTEN -nP 2>/dev/null
  else
    print -r -- '(no live plannotator processes)'
  fi
}
alias plans="plannotator sessions"

