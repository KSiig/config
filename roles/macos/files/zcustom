# ── Clipboard on the headless workbox ──────────────────────────────────────
# The box has no X server, so $DISPLAY is unset and oh-my-zsh's clipboard.zsh
# skips its xclip/xsel branches -- leaving no branch at all outside tmux, hence
# "Platform linux-gnu not supported". OSC 52 fixes this by handing the bytes to
# the *local* terminal: ghostty allows clipboard writes by default, and
# mosh 1.4.0 forwards the sequence.
#
# Guarded to Linux so the Mac keeps oh-my-zsh's pbcopy branch. Must stay after
# .zshrc line 75 (`source $ZSH/oh-my-zsh.sh`) to override its lazy stubs.
if [[ "$(uname)" == "Linux" ]]; then
  clipcopy() {
    # Always write the escape ourselves -- do NOT delegate to `tmux load-buffer -w`.
    # tmux hardcodes an EMPTY selection field (it emits `\033]52;;<b64>`), and
    # mosh 1.4.0 only relays the sequence when that field is exactly `c`, so the
    # tmux path is silently dropped in transit. Verified end-to-end against a
    # throwaway mosh-server: `]52;c;` arrives, `]52;;` never does. Overriding Ms
    # to hardcode `c` does not work either -- tmux's Ms expansion silently emits
    # nothing unless the format still consumes %p1%s.
    #
    # Writing to /dev/tty inside tmux is fine: tmux forwards a pane-originated
    # OSC 52 with the `c` preserved, and still populates its own paste buffer.
    if [[ -w /dev/tty ]]; then
      printf '\033]52;c;%s\a' "$(base64 -w0 < "${1:-/dev/stdin}")" > /dev/tty
    else
      print -u2 "clipcopy: no controlling terminal to send OSC 52 to"
      return 1
    fi
  }
  clippaste() {
    print -u2 "clippaste: unavailable on a headless box. OSC 52 reads are gated by the terminal (ghostty defaults clipboard-read to \"ask\") and mosh does not route the reply -- use the terminal's own paste."
    return 1
  }
fi

