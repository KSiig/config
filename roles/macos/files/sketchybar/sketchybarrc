#!/usr/bin/env bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

sketchybar --bar \
    position=bottom \
    height=36 \
    color=0x00000000 \
    border_width=0 \
    shadow=off \
    topmost=on \
    y_offset=4

sketchybar --default \
    label.font="Symbols Nerd Font:Regular:16.0" \
    label.color=0xffCFC2B0 \
    background.drawing=off \
    padding_left=2 \
    padding_right=2

sketchybar --add event aerospace_workspace_change

declare -A WORKSPACE_ICONS
WORKSPACE_ICONS=(
    [1]="󰂺"
    [2]="󰨞"
    [3]="󰆍"
    [4]="󰒱"
    [5]="󰔟"
    [6]="󰋜"
    [7]="󰅟"
)

SPACE_ITEMS=()
for sid in $(aerospace list-workspaces --all); do
    icon="${WORKSPACE_ICONS[$sid]:-$sid}"
    sketchybar --add item space.$sid center \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        label="$icon" \
        label.padding_left=10 \
        label.padding_right=10 \
        click_script="aerospace workspace $sid" \
        script="$PLUGIN_DIR/aerospace.sh $sid"
    SPACE_ITEMS+=("space.$sid")
done

sketchybar --add bracket spaces "${SPACE_ITEMS[@]}" \
    --set spaces \
    background.color=0xee310020 \
    background.border_color=0xff63234D \
    background.border_width=1 \
    background.corner_radius=12 \
    background.height=28 \
    background.drawing=on

sketchybar --update
